#!/bin/sh
. /lib/functions/uci-defaults.sh
board_config_update
case "$(board_name)" in
misectel,m02k88) count=2;;
misectel,m01k43|misectel,m01k43-*|\
misectel,m02k45|misectel,m02k45-*|\
misectel,m02k21|misectel,m02k21-*) count=1;;
*) count=0;;
esac
json_add_int preset_modem_num "$count"
board_config_flush
