/dts-v1/;

#include "mt7981b-misectel-m01k43.dts"

/ {
	model = "Misectel M01K43 eMMC";
	compatible = "misectel,m01k43-emmc", "mediatek,mt7981";

	aliases {
		label-mac-device = &gmac1;
	};

	/* GPIO25 is the eMMC clock, not the NAND variant's modem power GPIO. */
	gpio-export {
		/delete-node/ 5gpower;
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	chosen {
		/delete-property/ bootargs-append;
		bootargs-override = "root=/dev/fit0 rootwait";
		rootdisk = <&emmc_rootdisk>;
	};

	memory@40000000 {
		reg = <0 0x40000000 0 0x80000000>;
	};
};

&pio {
	mmc0_pins_default: mmc0-pins-default {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};

	mmc0_pins_uhs: mmc0-pins-uhs {
		mux {
			function = "flash";
			groups = "emmc_45";
		};
	};
};

&mmc0 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <52000000>;
	cap-mmc-highspeed;
	cap-mmc-hw-reset;
	vmmc-supply = <&reg_3p3v>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				block-partition-env {
					partname = "uboot-env";

					nvmem-layout {
						compatible = "u-boot,env";
					};
				};

				block-partition-factory {
					partname = "factory";

					nvmem-layout {
						compatible = "fixed-layout";
						#address-cells = <1>;
						#size-cells = <1>;

						emmc_eeprom_factory_0: eeprom@0 {
							reg = <0x0 0x1000>;
						};

						emmc_macaddr_factory_4: macaddr@4 {
							compatible = "mac-base";
							reg = <0x4 0x6>;
							#nvmem-cell-cells = <1>;
						};
					};
				};

				emmc_rootdisk: block-partition-rootfs {
					partname = "rootfs";
				};
			};
		};
	};
};

&spi0 {
	status = "disabled";
};

&spi2 {
	status = "disabled";
};

/* This eMMC variant has one port on the MT7981 integrated GbE PHY. */
&eth {
	/delete-node/ mac@0;

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "gmii";
		phy-handle = <&int_gbe_phy>;
		nvmem-cell-names = "mac-address";
		nvmem-cells = <&emmc_macaddr_factory_4 0>;
	};
};

&mdio_bus {
	/delete-node/ phy@6;
	/delete-node/ switch@1f;
};

&wifi {
	nvmem-cells = <&emmc_eeprom_factory_0>;
};
