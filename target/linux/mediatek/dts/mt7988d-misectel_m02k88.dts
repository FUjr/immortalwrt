/dts-v1/;
#include "mt7988d-misectel_m02k45-common.dtsi"
#include "mt7988d-misectel-m02-spim-nand.dtsi"

/ {
	model = "Misectel M02K88";
	compatible = "misectel,m02k88", "mediatek,mt7988d";

	aliases {
		/delete-property/ led-boot;
		/delete-property/ led-failsafe;
		/delete-property/ led-running;
		/delete-property/ led-upgrade;
	};

	/* M02K88 uses two SIM + three-bar banks, not the M02K45 LEDs. */
	/delete-node/ gpio-leds;
	gpio-leds {
		compatible = "gpio-leds";

		led-lan2-green {
			label = "green:lan2";
			gpios = <&pio 65 GPIO_ACTIVE_LOW>;
		};

		led-lan2-amber {
			label = "amber:lan2";
			gpios = <&pio 59 GPIO_ACTIVE_LOW>;
		};

		led-lan3-green {
			label = "green:lan3";
			gpios = <&pio 64 GPIO_ACTIVE_HIGH>;
		};

		led-lan3-amber {
			label = "amber:lan3";
			gpios = <&pio 58 GPIO_ACTIVE_LOW>;
		};

		led-wifi {
			label = "wifi";
			gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
		};

		led-5g1-sim {
			label = "5g1:sim";
			gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
		};

		led-5g1-rf1 {
			label = "5g1:rf1";
			gpios = <&pio 1 GPIO_ACTIVE_HIGH>;
		};

		led-5g1-rf2 {
			label = "5g1:rf2";
			gpios = <&pio 3 GPIO_ACTIVE_HIGH>;
		};

		led-5g1-rf3 {
			label = "5g1:rf3";
			gpios = <&pio 28 GPIO_ACTIVE_HIGH>;
		};

		led-5g2-sim {
			label = "5g2:sim";
			gpios = <&pio 35 GPIO_ACTIVE_HIGH>;
		};

		led-5g2-rf1 {
			label = "5g2:rf1";
			gpios = <&pio 34 GPIO_ACTIVE_HIGH>;
		};

		led-5g2-rf2 {
			label = "5g2:rf2";
			gpios = <&pio 61 GPIO_ACTIVE_HIGH>;
		};

		led-5g2-rf3 {
			label = "5g2:rf3";
			gpios = <&pio 21 GPIO_ACTIVE_HIGH>;
		};
	};

	/delete-node/ gpio-export;
	gpio-export {
		compatible = "gpio-export";

		gpio-5g1-en {
			gpio-export,name = "5g1_en";
			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
			gpio-export,output = <0>;
		};

		gpio-5g2-en {
			gpio-export,name = "5g2_en";
			gpios = <&pio 14 GPIO_ACTIVE_LOW>;
			gpio-export,output = <0>;
		};
	};
};

/* Use GPIO netdev LEDs to honor the board-specific polarities. The MT7988
 * PHY driver has no led_polarity_set callback; DT active-low is rejected.
 * Empty PHY pinctrl states keep the GPIO LED pins out of hardware LED muxing.
 */
&gsw_phy0 {
	pinctrl-names = "gbe-led";
	pinctrl-0 = <>;
};

&gsw_phy0_led0 {
	status = "disabled";
};

&gsw_phy0_led1 {
	status = "disabled";
};

&gsw_phy1 {
	pinctrl-0 = <>;
};

&gsw_phy1_led0 {
	status = "disabled";
};

&gsw_phy1_led1 {
	status = "disabled";
};

/* LAN1 retains the PHY driver's strap-derived polarity. */
&gsw_phy2_led0 {
	/delete-property/ active-low;
};

&gsw_phy2_led1 {
	/delete-property/ active-low;
};

/* GPIO61 belongs to the second modem's RF2 LED. */
&gsw_phy3 {
	pinctrl-0 = <>;
};

&gsw_phy3_led0 {
	status = "disabled";
};

&gsw_phy3_led1 {
	status = "disabled";
};
