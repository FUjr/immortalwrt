/dts-v1/;
#include "mt7988d-misectel_m02k45-common.dtsi"

/ {
	chosen {
		/*
		 * Keep the SPI-NAND boot path on the UBI volume. Shipped U-Boot
		 * selects rootdisk-spim-nand from the BootROM medium and would
		 * otherwise override rootdisk with the eMMC production partition.
		 */
		rootdisk = <&ubi_rootdisk>;
		rootdisk-spim-nand = <&ubi_rootdisk>;
		rootdisk-emmc = <&emmc_rootdisk>;
	};
};

&pio {
	mmc0_pins_emmc_51: mmc0-emmc-51-pins {
		mux {
			function = "flash";
			groups = "emmc_51";
		};
	};
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_emmc_51>;
	pinctrl-1 = <&mmc0_pins_emmc_51>;
	bus-width = <8>;
	max-frequency = <52000000>;
	cap-mmc-highspeed;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_1p8v>;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";

	card@0 {
		compatible = "mmc-card";
		reg = <0>;

		block {
			compatible = "block-device";

			partitions {
				block-partition-recovery {
					partname = "recovery";
				};

				emmc_rootdisk: block-partition-production {
					partname = "production";
				};
			};
		};
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	spi_nand: flash@0 {
		compatible = "spi-nand";
		reg = <0>;

		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bl2";
				reg = <0x0 0x100000>;
			};

			partition@100000 {
				label = "u-boot-env";
				reg = <0x100000 0x80000>;
				read-only;
			};

			partition@180000 {
				label = "factory";
				reg = <0x180000 0x400000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x1e00>;
					};

					macaddr_factory_1e001c: eeprom@1e001c {
						compatible = "mac-base";
						reg = <0x1e001c 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@580000 {
				label = "fip";
				reg = <0x580000 0x200000>;
			};

			partition@780000 {
				label = "woem";
				reg = <0x780000 0x20000>;
				read-only;
			};

			partition@7a0000 {
				label = "ledeinfo";
				reg = <0x7a0000 0x20000>;
			};

			partition@7c0000 {
				compatible = "linux,ubi";
				reg = <0x7c0000 0x7040000>;
				label = "ubi";

				volumes {
					ubi_rootdisk: ubi-volume-fit {
						volname = "fit";
					};
				};
			};
		};
	};
};
