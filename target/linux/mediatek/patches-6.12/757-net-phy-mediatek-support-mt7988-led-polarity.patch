From: fjr <fujianrong@fnnas.com>
Subject: [PATCH] net: phy: mediatek: honor explicit MT7988 LED polarity

Reuse the existing LED polarity register interface for MT7988. Boards
without explicit LED polarity properties retain their strap-derived defaults.
The callback runs after PHY probe has initialized those defaults.

Signed-off-by: fjr <fujianrong@fnnas.com>
---
--- a/drivers/net/phy/mediatek/mtk-ge-soc.c
+++ b/drivers/net/phy/mediatek/mtk-ge-soc.c
@@ -1428,7 +1428,7 @@
 	return 0;
 }
 
-static int an7581_phy_led_polarity_set(struct phy_device *phydev, int index,
+static int mtk_socphy_led_polarity_set(struct phy_device *phydev, int index,
 				       unsigned long modes)
 {
 	u16 val = 0;
@@ -1488,6 +1488,7 @@
 		.led_hw_is_supported = mt798x_phy_led_hw_is_supported,
 		.led_hw_control_set = mt798x_phy_led_hw_control_set,
 		.led_hw_control_get = mt798x_phy_led_hw_control_get,
+		.led_polarity_set = mtk_socphy_led_polarity_set,
 	},
 	{
 		PHY_ID_MATCH_EXACT(MTK_GPHY_ID_AN7581),
@@ -1498,7 +1499,7 @@
 		.led_hw_is_supported = mt798x_phy_led_hw_is_supported,
 		.led_hw_control_set = mt798x_phy_led_hw_control_set,
 		.led_hw_control_get = mt798x_phy_led_hw_control_get,
-		.led_polarity_set = an7581_phy_led_polarity_set,
+		.led_polarity_set = mtk_socphy_led_polarity_set,
 	},
 };
 
