From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Misectel <fjr@misectel>
Date: Fri Aug 14 00:00:00 2026 +0000
Subject: [PATCH] net: dsa: mt7530: mt7621: align switch init with vendor SDK

The MT7621 vendor SDK (gsw_mt7621.c / ra_esw_mt7621.c) programs several
switch registers that the mainline mt7530 driver never writes:

- P6 "central align" (P6ECR bits 0:1 -> mode 2, clear TRGMII_TXCTRL bit
  30, TRGMII_TCK_CTRL = 0x0855) for the RGMII CPU port;
- P5 RGMII RX/TX clock delay (P5RGMIIRXCR = 0x102, P5RGMIITXCR = 0x14)
  when PHY muxing is in use;
- lower TRGMII Tx drive strength (0x44 instead of 0x88).

Without these, the 100BASE-TX link on the 4-wire 7621EVB flaps. Add them
so the switch init matches the vendor SDK.

Signed-off-by: fjr <fjrcn@outlook.com>
---
 drivers/net/dsa/mt7530.c | 22 ++++++++++++++++++++--
 1 file changed, 20 insertions(+), 2 deletions(-)

--- a/drivers/net/dsa/mt7530.c
+++ b/drivers/net/dsa/mt7530.c
@@ -412,6 +412,10 @@
 	if (interface == PHY_INTERFACE_MODE_RGMII) {
 		mt7530_rmw(priv, MT7530_P6ECR, P6_INTF_MODE_MASK,
 			   P6_INTF_MODE(0));
+		/* MT7621 vendor SDK: central align */
+		mt7530_rmw(priv, MT7530_P6ECR, BIT(0) | BIT(1), BIT(1));
+		mt7530_rmw(priv, MT7530_TRGMII_TXCTRL, BIT(30), 0);
+		mt7530_write(priv, MT7530_TRGMII_TCK_CTRL, 0x0855);
 		return;
 	}
 
@@ -2412,10 +2416,10 @@
 		     SYS_CTRL_PHY_RST | SYS_CTRL_SW_RST |
 		     SYS_CTRL_REG_RST);
 
-	/* Lower Tx driving for TRGMII path */
+	/* Lower Tx driving for TRGMII path (vendor SDK uses 0x44) */
 	for (i = 0; i < NUM_TRGMII_CTRL; i++)
 		mt7530_write(priv, MT7530_TRGMII_TD_ODT(i),
-			     TD_DM_DRVP(8) | TD_DM_DRVN(8));
+			     TD_DM_DRVP(4) | TD_DM_DRVN(4));
 
 	for (i = 0; i < NUM_TRGMII_CTRL; i++)
 		mt7530_rmw(priv, MT7530_TRGMII_RD(i),
@@ -2432,6 +2436,10 @@
 
 	mt753x_trap_frames(priv);
 
+	/* MT7621 vendor SDK: P5 RGMII RX/TX clock delay (for the PHY mux) */
+	mt7530_write(priv, MT7530_P5RGMIIRXCR, 0x0102);
+	mt7530_write(priv, MT7530_P5RGMIITXCR, 0x0014);
+
 	/* Enable and reset MIB counters */
 	mt7530_mib_reset(ds);
 
@@ -2545,6 +2553,10 @@
 
 	mt753x_trap_frames(priv);
 
+	/* MT7621 vendor SDK: P5 RGMII RX/TX clock delay (for the PHY mux) */
+	mt7530_write(priv, MT7530_P5RGMIIRXCR, 0x0102);
+	mt7530_write(priv, MT7530_P5RGMIITXCR, 0x0014);
+
 	/* Enable and reset MIB counters */
 	mt7530_mib_reset(ds);
 
