#include <dt-bindings/input/input.h>
#include "mt7621.dtsi"

/ {
	compatible = "nex905,f-405", "mediatek,mt7621-soc";
	model = "NAT Gateway NEX905-F-405";

	aliases {
		label-mac-device = &gmac0;
		led-upgrade = &watchdog_feed;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		wan-link {
			label = "wan:link";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		lan1-link {
			label = "lan1:link";
			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		lan2-link {
			label = "lan2:link";
			gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		lan3-link {
			label = "lan3:link";
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		lan4-link {
			label = "lan4:link";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
			default-state = "off";
		};

		watchdog_feed: watchdog-feed {
			label = "watchdog-feed";
			gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "timer";
			led-pattern = <1000 1000>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x030000>;
				read-only;
			};

			partition@30000 {
				label = "u-boot-env";
				reg = <0x030000 0x010000>;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x040000 0x010000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_factory_e000: macaddr@e000 {
						compatible = "mac-base";
						reg = <0xe000 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			partition@50000 {
				label = "woem";
				reg = <0x050000 0x010000>;
			};

			partition@60000 {
				label = "ledeinfo";
				reg = <0x060000 0x010000>;
			};

			partition@70000 {
				compatible = "denx,uimage";
				label = "firmware";
				reg = <0x070000 0xf90000>;
			};
		};
	};
};

&i2c {
	status = "okay";

	rtc@51 {
		compatible = "nxp,pcf85063a";
		reg = <0x51>;
	};
};

&gmac0 {
	nvmem-cells = <&macaddr_factory_e000 0>;
	nvmem-cell-names = "mac-address";
};

&gmac1 {
	status = "okay";
	label = "wan";
	phy-handle = <&ethphy0>;

	nvmem-cells = <&macaddr_factory_e000 1>;
	nvmem-cell-names = "mac-address";
};

&ethphy0 {
	mediatek,led0-activity-only;
	/delete-property/ interrupts;
};

&switch0 {
	ports {
		/delete-node/ port@0;

		port@1 {
			status = "okay";
			label = "lan1";
			nvmem-cells = <&macaddr_factory_e000 0>;
			nvmem-cell-names = "mac-address";
		};

		port@2 {
			status = "okay";
			label = "lan2";
			nvmem-cells = <&macaddr_factory_e000 0>;
			nvmem-cell-names = "mac-address";
		};

		port@3 {
			status = "okay";
			label = "lan3";
			nvmem-cells = <&macaddr_factory_e000 0>;
			nvmem-cell-names = "mac-address";
		};

		port@4 {
			status = "okay";
			label = "lan4";
			nvmem-cells = <&macaddr_factory_e000 0>;
			nvmem-cell-names = "mac-address";
		};
	};
};

&state_default {
	gpio {
		groups = "jtag", "uart3", "wdt", "uart2";
		function = "gpio";
	};
};

&ethphy1 {
	mediatek,led0-activity-only;
};

&ethphy2 {
	mediatek,led0-activity-only;
};

&ethphy3 {
	mediatek,led0-activity-only;
};

&ethphy4 {
	mediatek,led0-activity-only;
};
