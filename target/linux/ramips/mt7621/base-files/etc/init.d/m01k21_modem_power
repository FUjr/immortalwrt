#!/bin/sh /etc/rc.common

START=96
STOP=99

GPIO_PATH="${GPIO_PATH:-/sys/class/gpio/5gpower/value}"
SYSTEM_LED_PATH="${SYSTEM_LED_PATH:-/sys/class/leds/lede:blue:blue}"

is_m01k21()
{
	[ "$(board_name)" = 'misectel,m01k21' ]
}

set_modem_power()
{
	local value="$1"

	[ -w "$GPIO_PATH" ] || {
		logger -t m01k21_modem_power "GPIO is unavailable: $GPIO_PATH"
		return 1
	}

	echo "$value" > "$GPIO_PATH"
}

set_system_led()
{
	local triggers=''

	[ -w "$SYSTEM_LED_PATH/trigger" ] || {
		logger -t m01k21_modem_power "System LED is unavailable: $SYSTEM_LED_PATH"
		return 1
	}

	triggers="$(tr -d '[]' < "$SYSTEM_LED_PATH/trigger")"
	case " $triggers " in
	*' timer '*)
		echo timer > "$SYSTEM_LED_PATH/trigger"
		echo 1000 > "$SYSTEM_LED_PATH/delay_on"
		echo 1000 > "$SYSTEM_LED_PATH/delay_off"
		;;
	*' heartbeat '*)
		echo heartbeat > "$SYSTEM_LED_PATH/trigger"
		;;
	*)
		[ -r "$SYSTEM_LED_PATH/max_brightness" ] || return 1
		cat "$SYSTEM_LED_PATH/max_brightness" > "$SYSTEM_LED_PATH/brightness"
		;;
	esac
}

start()
{
	local power_status=0

	is_m01k21 || return 0

	# GPIO 16 is active-low: low powers the modem, high removes power.
	set_modem_power 0 || power_status=$?
	set_system_led || true
	return "$power_status"
}

stop()
{
	is_m01k21 || return 0

	# Keep the modem off; U-Boot performs the timed high-to-low power cycle.
	set_modem_power 1 || return 0
}
