+++ b/arch/arm/dts/mt7981-misectel-m01k43-emmc.dts
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/dts-v1/;
+
+#include "mt7981.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/pinctrl/mt65xx.h>
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	model = "Misectel M01K43 eMMC";
+	compatible = "misectel,m01k43-emmc", "mediatek,mt7981";
+
+	chosen {
+		stdout-path = &uart0;
+		tick-timer = &timer0;
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x80000000>;
+	};
+
+	reg_3p3v: regulator-3p3v {
+		compatible = "regulator-fixed";
+		regulator-name = "fixed-3.3V";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-boot-on;
+		regulator-always-on;
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		button-internet {
+			label = "internet";
+			linux,code = <BTN_0>;
+			linux,input-type = <EV_SW>;
+			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
+		};
+
+		button-reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led-wifi {
+			label = "blue:wifi";
+			gpios = <&pio 9 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-4g-blue {
+			label = "blue:4g";
+			gpios = <&pio 13 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-4g-yellow {
+			label = "yellow:4g";
+			gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-5g-blue {
+			label = "blue:5g";
+			gpios = <&pio 11 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-5g-yellow {
+			label = "yellow:5g";
+			gpios = <&pio 12 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-internet-blue {
+			label = "blue:internet";
+			gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
+		};
+
+		led-internet-red {
+			label = "red:internet";
+			gpios = <&pio 6 GPIO_ACTIVE_HIGH>;
+		};
+	};
+};
+
+&eth {
+	status = "okay";
+	mediatek,gmac-id = <0>;
+	phy-mode = "2500base-x";
+	mediatek,switch = "mt7531";
+	reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;
+
+	fixed-link {
+		speed = <2500>;
+		full-duplex;
+	};
+};
+
+&mmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc0_pins_default>;
+	max-frequency = <52000000>;
+	bus-width = <8>;
+	cap-mmc-highspeed;
+	cap-mmc-hw-reset;
+	vmmc-supply = <&reg_3p3v>;
+	non-removable;
+	status = "okay";
+};
+
+&pio {
+	mmc0_pins_default: mmc0default {
+		mux {
+			function = "flash";
+			groups = "emmc_45";
+		};
+
+		conf-cmd-dat {
+			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO",
+			       "SPI0_CS", "SPI0_HOLD", "SPI0_WP",
+			       "SPI1_CLK", "SPI1_MOSI", "SPI1_MISO";
+			input-enable;
+			drive-strength = <MTK_DRIVE_4mA>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+
+		conf-clk {
+			pins = "SPI1_CS";
+			drive-strength = <MTK_DRIVE_6mA>;
+			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
+		};
+
+		conf-rst {
+			pins = "PWM0";
+			drive-strength = <MTK_DRIVE_4mA>;
+			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
+		};
+	};
+};
+
+&uart0 {
+	mediatek,force-highspeed;
+	status = "okay";
+};
+
+&watchdog {
+	status = "disabled";
+};
--- /dev/null
+++ b/defenvs/misectel_m01k43-emmc_env
@@ -0,0 +1,33 @@
+ipaddr=192.168.1.1
+serverip=192.168.1.254
+loadaddr=0x46000000
+bootargs=console=ttyS0,115200n8 root=/dev/fit0 rootwait
+bootconf=config-1
+bootcmd=run boot_rootfs
+bootdelay=3
+bootfile=immortalwrt-mediatek-filogic-misectel_m01k43-emmc-initramfs-recovery.itb
+bootfile_bl2=immortalwrt-mediatek-filogic-misectel_m01k43-emmc-emmc-preloader.bin
+bootfile_uboot=immortalwrt-mediatek-filogic-misectel_m01k43-emmc-emmc-bl31-uboot.fip
+bootfile_rootfs=immortalwrt-mediatek-filogic-misectel_m01k43-emmc-squashfs-sysupgrade.itb
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=Misectel M01K43 eMMC
+bootmenu_0=Boot rootfs from eMMC.=run boot_rootfs
+bootmenu_1=Boot ramfs via TFTP.=run boot_tftp
+bootmenu_2=Write rootfs via TFTP.=run boot_tftp_write_rootfs
+bootmenu_3=Write U-Boot via TFTP.=run boot_tftp_write_uboot
+bootmenu_4=Write BL2 via TFTP.=run boot_tftp_write_bl2
+bootmenu_5=Reset environment.=eraseenv ; reset
+bootmenu_6=Reboot.=reset
+boot_rootfs=part start mmc 0 rootfs part_addr && part size mmc 0 rootfs part_size && run mmc_read_fit && bootm $loadaddr#$bootconf
+boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
+boot_tftp_write_rootfs=tftpboot $loadaddr $bootfile_rootfs && run mmc_write_rootfs
+boot_tftp_write_uboot=tftpboot $loadaddr $bootfile_uboot && run mmc_write_uboot
+boot_tftp_write_bl2=tftpboot $loadaddr $bootfile_bl2 && run mmc_write_bl2
+mmc_read_fit=mmc read $loadaddr $part_addr 0x100 && imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc read $loadaddr $part_addr $image_size
+mmc_write_fit=imszb $loadaddr image_size && test 0x$image_size -le 0x$part_size && mmc erase $part_addr $part_size && mmc write $loadaddr $part_addr $image_size
+mmc_write_rootfs=part start mmc 0 rootfs part_addr && part size mmc 0 rootfs part_size && run mmc_write_fit
+mmc_write_uboot=part start mmc 0 uboot part_addr && part size mmc 0 uboot part_size && setexpr image_blocks $filesize + 0x1ff && setexpr image_blocks $image_blocks / 0x200 && test $image_blocks -le $part_size && mmc erase $part_addr $part_size && mmc write $loadaddr $part_addr $image_blocks
+mmc_write_bl2=setexpr image_blocks $filesize + 0x1ff && setexpr image_blocks $image_blocks / 0x200 && test $image_blocks -le 0x400 && mmc partconf 0 1 1 1 && mmc erase 0 0x400 && mmc write $loadaddr 0 $image_blocks ; mmc partconf 0 1 1 0
+ethaddr_factory=part start mmc 0 factory part_addr && mmc read 0x46000000 $part_addr 8 && env readmem -b ethaddr 0x46000004 6
+_init_env=run ethaddr_factory ; saveenv ; saveenv
