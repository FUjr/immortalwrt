--- /dev/null
+++ b/defenvs/nex905_f405_32m_env
@@ -0,0 +1,19 @@
+ethaddr_factory=mtd read factory $loadaddr 0x0 0x10000 && setexpr macoffs $loadaddr + 0xe000 && env readmem -b ethaddr $macoffs 0x6
+ipaddr=192.168.1.1
+serverip=192.168.1.254
+loadaddr=0x83000000
+active_slot=A
+bootcmd=run ethaddr_factory; run boot_ab
+bootdelay=3
+boot_ab=if test "$active_slot" = B; then run boot_b; else run boot_a; fi
+parts_common=192k(u-boot)ro,64k(u-boot-env),64k(factory)ro,64k(woem),64k(ledeinfo)
+parts_a=15936k@448k(firmware),15936k@16384k(firmware_inactive)
+parts_b=15936k@16384k(firmware),15936k@448k(firmware_inactive)
+parts_tail=64k@32704k(u-boot-env-redund)
+boot_a=setenv bootargs console=ttyS0,115200 rootfstype=squashfs,jffs2 rootwait panic=3 ab_slot=A mtdparts=spi0.0:${parts_common},${parts_a},${parts_tail}; sf probe && sf read $loadaddr 0x70000 0xf90000 && bootm $loadaddr
+boot_b=setenv bootargs console=ttyS0,115200 rootfstype=squashfs,jffs2 rootwait panic=3 ab_slot=B mtdparts=spi0.0:${parts_common},${parts_b},${parts_tail}; sf probe && sf read $loadaddr 0x1000000 0xf90000 && bootm $loadaddr
+bootfile=immortalwrt-ramips-mt7621-nex905_f-405-32m-initramfs-kernel.bin
+boot_tftp=setenv bootargs console=ttyS0,115200; tftpboot $loadaddr $bootfile && bootm $loadaddr
+stdin=serial
+stdout=serial
+stderr=serial
--- /dev/null
+++ b/arch/mips/dts/nex905,f-405-32m.dts
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/dts-v1/;
+
+#include "mt7621.dtsi"
+
+/ {
+	compatible = "nex905,f-405-32m", "mediatek,mt7621-rfb", "mediatek,mt7621-soc";
+	model = "NEX905 F-405 32M A/B";
+
+	aliases {
+		ethernet0 = &eth;
+		serial0 = &uart0;
+		spi0 = &spi;
+	};
+
+	chosen {
+		stdout-path = &uart0;
+	};
+};
+
+&pinctrl {
+	state_default: pin_state {
+		gpios {
+			groups = "i2c", "uart3", "pcie reset";
+			function = "gpio";
+		};
+
+		wdt {
+			groups = "wdt";
+			function = "wdt rst";
+		};
+
+		jtag {
+			groups = "jtag";
+			function = "jtag";
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&gpio {
+	status = "okay";
+};
+
+&spi {
+	status = "okay";
+	num-cs = <2>;
+
+	spi-flash@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		spi-max-frequency = <25000000>;
+		reg = <0>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x030000>;
+			};
+
+			partition@30000 {
+				label = "u-boot-env";
+				reg = <0x030000 0x010000>;
+			};
+
+			partition@40000 {
+				label = "factory";
+				reg = <0x040000 0x010000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "woem";
+				reg = <0x050000 0x010000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "ledeinfo";
+				reg = <0x060000 0x010000>;
+			};
+
+			partition@70000 {
+				label = "firmware_a";
+				reg = <0x070000 0xf90000>;
+			};
+
+			partition@1000000 {
+				label = "firmware_b";
+				reg = <0x1000000 0xf90000>;
+			};
+		};
+	};
+};
+
+&eth {
+	status = "okay";
+};
+
+&ssusb {
+	status = "okay";
+};
+
+&u3phy {
+	status = "okay";
+};
