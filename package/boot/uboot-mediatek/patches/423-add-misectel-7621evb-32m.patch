--- /dev/null
+++ b/defenvs/misectel_7621evb_32m_env
@@ -0,0 +1,39 @@
+ethaddr_factory=mtd read factory $loadaddr 0x0 0x10000 ; setexpr macoffs $loadaddr + 0xe000 ; env readmem -b ethaddr $macoffs 0x6 ; setenv ethaddr_factory
+ipaddr=192.168.1.1
+serverip=192.168.1.254
+loadaddr=0x83000000
+bootcmd=run ethaddr_factory ; run boot_ab
+bootdelay=3
+bootfile=immortalwrt-ramips-mt7621-misectel_7621evb-32m-initramfs-kernel.bin
+bootfile_uboot=immortalwrt-ramips-mt7621-misectel_7621evb-32m-u-boot.bin
+bootfile_upg=immortalwrt-ramips-mt7621-misectel_7621evb-32m-squashfs-sysupgrade.bin
+bootmenu_default=0
+bootmenu_delay=3
+bootmenu_title=Misectel 7621EVB 32M
+bootmenu_0=Boot system from active slot.=run boot_nor
+bootmenu_1=Boot recovery image via TFTP.=run boot_tftp
+bootmenu_2=Write sysupgrade image to inactive slot via TFTP.=run boot_tftp_sysupgrade
+bootmenu_3=Write U-Boot via TFTP.=run boot_tftp_write_uboot
+bootmenu_4=Reset environment and reboot.=eraseenv ; reset
+bootmenu_5=Reboot.=reset
+active_slot=A
+try_slot=
+boot_attempts=2
+boot_nor=if test "$active_slot" = A ; then run boot_slot_A ; else run boot_slot_B ; fi
+boot_ab=if test -n "$try_slot" ; then if test "$boot_attempts" -gt 0 ; then setexpr boot_attempts $boot_attempts - 1 ; saveenv ; echo "A/B: trying slot $try_slot, attempts left $boot_attempts" ; if test "$try_slot" = A ; then run boot_try_A ; else run boot_try_B ; fi ; else echo "A/B: slot $try_slot failed, reverting to $active_slot" ; run boot_revert ; fi ; else if test "$active_slot" = A ; then run boot_slot_A ; else run boot_slot_B ; fi ; fi
+boot_try_A=if run boot_slot_A ; then echo "A/B: slot A is up" ; else echo "A/B: slot A failed to boot, reverting" ; run boot_revert ; fi
+boot_try_B=if run boot_slot_B ; then echo "A/B: slot B is up" ; else echo "A/B: slot B failed to boot, reverting" ; run boot_revert ; fi
+boot_revert=setenv try_slot ; setenv boot_attempts 2 ; saveenv ; echo "A/B: reverting to active slot $active_slot" ; if test "$active_slot" = A ; then run boot_slot_A ; else run boot_slot_B ; fi
+boot_slot_A=setenv bootargs console=ttyS0,115200 root=/dev/mtdblock6 rootwait panic=1 slot=A ; bootm 0x1fc70000
+boot_slot_B=setenv bootargs console=ttyS0,115200 root=/dev/mtdblock9 rootwait panic=1 slot=B ; sf probe ; sf read $loadaddr 0x1000000 0x800000 ; bootm $loadaddr
+boot_tftp=setenv bootargs console=ttyS0,115200 ; tftpboot $loadaddr $bootfile && bootm $loadaddr
+boot_tftp_sysupgrade=tftpboot $loadaddr $bootfile_upg && iminfo $loadaddr && run nor_write_inactive
+boot_tftp_write_uboot=tftpboot $loadaddr $bootfile_uboot && run nor_write_uboot
+nor_pad_size=setexpr image_eb $filesize / 0x1000 ; setexpr image_rem $filesize % 0x1000 ; test 0x$image_rem -gt 0 && setexpr image_eb $image_eb + 1 ; setexpr image_eb $image_eb * 0x1000
+nor_write_inactive=if test "$active_slot" = A ; then run nor_write_b ; else run nor_write_a ; fi
+nor_write_a=run nor_pad_size ; test 0x$image_eb -le 0xf90000 && mtd erase firmware_a 0x0 0x$image_eb && mtd write firmware_a $loadaddr 0x0 $filesize ; setenv try_slot A ; setenv boot_attempts 2 ; saveenv
+nor_write_b=run nor_pad_size ; test 0x$image_eb -le 0xf90000 && mtd erase firmware_b 0x0 0x$image_eb && mtd write firmware_b $loadaddr 0x0 $filesize ; setenv try_slot B ; setenv boot_attempts 2 ; saveenv
+nor_write_uboot=test 0x$filesize -le 0x30000 && mtd erase u-boot 0x0 0x30000 && mtd write u-boot $loadaddr 0x0 $filesize
+stdin=serial
+stdout=serial
+stderr=serial
--- /dev/null
+++ b/arch/mips/dts/misectel,7621evb-32m.dts
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/dts-v1/;
+
+#include "mt7621.dtsi"
+
+/ {
+	compatible = "misectel,7621evb-32m", "mediatek,mt7621-rfb", "mediatek,mt7621-soc";
+	model = "Misectel 7621EVB 32M";
+
+	aliases {
+		ethernet0 = &eth;
+		serial0 = &uart0;
+		spi0 = &spi;
+	};
+
+	chosen {
+		stdout-path = &uart0;
+	};
+};
+
+&pinctrl {
+	state_default: pin_state {
+		gpios {
+			groups = "i2c", "uart3", "pcie reset";
+			function = "gpio";
+		};
+
+		wdt {
+			groups = "wdt";
+			function = "wdt rst";
+		};
+
+		jtag {
+			groups = "jtag";
+			function = "jtag";
+		};
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&gpio {
+	status = "okay";
+};
+
+&spi {
+	status = "okay";
+	num-cs = <2>;
+
+	spi-flash@0 {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		compatible = "jedec,spi-nor";
+		spi-max-frequency = <25000000>;
+		reg = <0>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "u-boot";
+				reg = <0x000000 0x030000>;
+			};
+
+			partition@30000 {
+				label = "u-boot-env";
+				reg = <0x030000 0x010000>;
+			};
+
+			partition@40000 {
+				label = "factory";
+				reg = <0x040000 0x010000>;
+				read-only;
+			};
+
+			partition@50000 {
+				label = "woem";
+				reg = <0x050000 0x010000>;
+				read-only;
+			};
+
+			partition@60000 {
+				label = "ledeinfo";
+				reg = <0x060000 0x010000>;
+			};
+
+			partition@70000 {
+				label = "firmware_a";
+				reg = <0x070000 0xf90000>;
+			};
+
+			partition@1000000 {
+				label = "firmware_b";
+				reg = <0x1000000 0xf90000>;
+			};
+		};
+	};
+};
+
+&eth {
+	status = "okay";
+};
+
+&ssusb {
+	status = "okay";
+};
+
+&u3phy {
+	status = "okay";
+};
