--- /dev/null
+++ b/arch/arm/dts/mt7986a-alwaylink-m60k63.dts
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+/dts-v1/;
+#include "mt7986a-rfb.dts"
+#include <dt-bindings/input/linux-event-codes.h>
+/ {
+	model = "Alwaylink M60K63";
+	compatible = "alwaylink,m60k63", "mediatek,mt7986";
+	alwaylink,modem-power-gpios = <&pio 13 GPIO_ACTIVE_LOW>;
+	memory@40000000 { reg = <0x40000000 0x40000000>; };
+	keys {
+		compatible = "gpio-keys";
+		reset { label = "reset"; linux,code = <KEY_RESTART>;
+			gpios = <&pio 9 GPIO_ACTIVE_LOW>; };
+	};
+};
+&snand { status = "disabled"; };
+&spi0 {
+	/delete-node/ spi_nor@0;
+	/delete-node/ spi_nand@1;
+	spi_nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <20000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+	};
+};
