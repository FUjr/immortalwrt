+++ b/board/mediatek/mt7986/mt7986_rfb.c
@@ -10,6 +10,8 @@
 #include <env.h>
 #include <init.h>
 #include <asm/io.h>
+#include <asm/gpio.h>
+#include <dm/ofnode.h>
 #include <linux/delay.h>
 #include <linux/libfdt.h>
 #include <mtd.h>
@@ -20,6 +22,28 @@
 #ifndef CONFIG_RESET_BUTTON_LABEL
 #define CONFIG_RESET_BUTTON_LABEL "reset"
 #endif
+
+static int m60k63_cycle_modem_power(void)
+{
+	struct gpio_desc power;
+	int ret;
+
+	if (!of_machine_is_compatible("alwaylink,m60k63"))
+		return 0;
+
+	/* Inactive is physical high: GPIO13 low enables modem power. */
+	ret = gpio_request_by_name_nodev(ofnode_root(),
+		"alwaylink,modem-power-gpios", 0, &power, GPIOD_IS_OUT);
+	if (ret)
+		return ret;
+	mdelay(1000);
+	ret = dm_gpio_set_value(&power, 1);
+	if (ret)
+		return ret;
+	mdelay(1000);
+	puts("M60K63: modem power cycled on GPIO13\n");
+	return 0;
+}
 
