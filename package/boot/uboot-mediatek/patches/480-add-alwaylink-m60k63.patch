+		ret = nmbm_attach_mtd(lower,
+			NMBM_F_READ_ONLY | NMBM_F_EMPTY_PAGE_ECC_OK,
+			1, 256, &upper);
+		if (ret)
+			return ret;
+		return add_mtd_device(upper);
+	}
+#endif
